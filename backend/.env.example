# =======================================================
# BACKEND ENVIRONMENT VARIABLES (backend/.env)
# =======================================================

# Database connection URL (PostgreSQL in production, SQLite fallback in local development)
# PostgreSQL example: postgresql+psycopg://postgres:password@localhost:5432/support_crm
# Supabase example:   postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=sqlite:///./support_crm.db

# CORS Allowed Origins (comma-separated list, or * for open dev)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional AI Ticket Assistant API key (Gemini)
# Leave blank to use heuristic fallback triage without external API dependency
AI_API_KEY=
GEMINI_API_KEY=

# Server Port (default 8000)
PORT=8000
